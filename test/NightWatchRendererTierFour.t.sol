pragma solidity 0.8.26;

import {MainnetFixture} from "./helpers/MainnetFixture.sol";

/// @dev The brief supplies no tier-4 hash. Anchor this missing tier to the supplied
/// Supervisor hash and apply only the literal tier-3 -> tier-4 differences from
/// the brief. No expected bytes are generated by NightWatchRenderer.
contract NightWatchRendererTierFourTest is MainnetFixture {
    function setUp() public {
        _loadMainnet();
    }

    function test_tierFourExactlyMatchesSpecifiedChangesToSupervisor() public view {
        Vector memory v = _vector(2);
        string memory expected = vm.readFile("docs/images/supervisor.svg");
        assertEq(keccak256(bytes(expected)), 0x77a2bd2785100118716ecfd64d45fac8dc442da9985103657651e4cdfd3cff34);

        expected = _replace(expected, 'height="1000" color="#A98BFF"', 'height="1000" color="#FF4FD8"', 1);
        expected = _replace(expected, 'flood-color="#A98BFF"', 'flood-color="#FF4FD8"', 2);
        expected =
            _replace(expected, 'r="480" fill="url(#otL)" opacity=".8"', 'r="480" fill="url(#otL)" opacity=".9"', 1);
        expected =
            _replace(expected, 'stroke-dasharray="8 44" opacity=".22"', 'stroke-dasharray="8 44" opacity=".34"', 1);

        string memory shade = '<rect x="0" y="0" width="1000" height="1000" fill="url(#vignette)"/>';
        // Tier 3 ends at k=5. Tier 4 adds k=6..9 with (X,Y,R,D):
        // (182,718,4,6), (781,801,6,7), (256,884,8,4), (857,627,4,5).
        expected = _replace(
            expected,
            string.concat("</circle></g>", shade),
            string.concat(
                "</circle>",
                '<circle cx="182" cy="718" r="4" fill="currentColor"><animateTransform attributeName="transform" type="translate" values="0 0;0 -280" dur="6s" repeatCount="indefinite"/><animate attributeName="opacity" values="0;1;0" dur="6s" repeatCount="indefinite"/></circle>',
                '<circle cx="781" cy="801" r="6" fill="currentColor"><animateTransform attributeName="transform" type="translate" values="0 0;0 -280" dur="7s" repeatCount="indefinite"/><animate attributeName="opacity" values="0;1;0" dur="7s" repeatCount="indefinite"/></circle>',
                '<circle cx="256" cy="884" r="8" fill="currentColor"><animateTransform attributeName="transform" type="translate" values="0 0;0 -280" dur="4s" repeatCount="indefinite"/><animate attributeName="opacity" values="0;1;0" dur="4s" repeatCount="indefinite"/></circle>',
                '<circle cx="857" cy="627" r="4" fill="currentColor"><animateTransform attributeName="transform" type="translate" values="0 0;0 -280" dur="5s" repeatCount="indefinite"/><animate attributeName="opacity" values="0;1;0" dur="5s" repeatCount="indefinite"/></circle></g>',
                '<rect x="-500" y="0" width="2000" height="1000" fill="url(#otH)" opacity=".45" style="mix-blend-mode:overlay"><animateTransform attributeName="transform" type="translate" values="-1000 0;1000 0" dur="6s" repeatCount="indefinite"/></rect>',
                shade
            ),
            1
        );

        string memory innerEnd = '<path d="M500 24V44M24 500H44M956 500H976" stroke="currentColor" stroke-width="4"/>';
        expected = _replace(
            expected,
            innerEnd,
            string.concat(
                innerEnd,
                '<path d="M60 24H940L976 60V940L940 976H60L24 940V60Z" fill="none" stroke="currentColor" stroke-width="12" filter="url(#glow)"><animate attributeName="opacity" values=".15;.7;.15" dur="4s" repeatCount="indefinite"/></path>'
            ),
            1
        );
        expected = _replace(
            expected,
            '<rect x="168" y="158" width="26" height="8" fill="currentColor" opacity=".2"/>',
            '<rect x="168" y="158" width="26" height="8" fill="currentColor" opacity="1"/>',
            1
        );
        expected = _replace(
            expected,
            '<path d="M884 50L936 80V140L884 170L832 140V80Z" fill="#08070D" stroke="currentColor" stroke-width="5"/><text x="884" y="126" font-size="34" fill="currentColor" text-anchor="middle">III</text>',
            '<path d="M884 50L936 80V140L884 170L832 140V80Z" fill="currentColor" stroke="currentColor" stroke-width="5"/><text x="884" y="126" font-size="40" fill="#08070D" text-anchor="middle">IV</text>',
            1
        );
        expected = _replace(expected, "NIGHTSHIFT / NIGHT WATCH / TIER III", "NIGHTSHIFT / NIGHT WATCH / TIER IV", 1);

        v.tier = 4;
        assertEq(_render(v), expected, "tier 4 differs from the literal specification");
    }

    function test_gasTierFourCold() public {
        Vector memory v = _vector(2);
        v.tier = 4;
        for (uint256 i; i < dependencyAccounts.length; ++i) {
            vm.cool(dependencyAccounts[i]);
        }
        vm.cool(address(renderer));
        uint256 start = gasleft();
        string memory result = _render(v);
        uint256 used = start - gasleft();
        emit log_named_uint("tier four cold svg gas", used);
        assertGt(bytes(result).length, 0);
        assertLt(used, 1_000_000, "unexpected rendering gas regression");
    }

    function _replace(string memory text, string memory before, string memory after_, uint256 occurrences)
        private
        pure
        returns (string memory)
    {
        assertEq(vm.split(text, before).length, occurrences + 1, "wrong number of oracle anchors");
        return vm.replace(text, before, after_);
    }
}
